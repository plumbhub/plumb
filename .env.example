# Copy these into Vercel → Project → Settings → Environment Variables.
# Never put real keys in your code or on GitHub.

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...
FREE_MODEL=claude-haiku-5-5
PRO_MODEL=claude-sonnet-5-5

# Clerk (dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Stripe (dashboard.stripe.com → Developers)
STRIPE_SECRET_KEY=sk_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Your live site address, no slash at the end
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Daily limits
FREE_DAILY_LIMIT=5
PRO_DAILY_LIMIT=200
